{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopee-cashback-production",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
